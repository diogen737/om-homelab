# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables

# The location where your uploaded files are stored
IMMICH_UPLOAD_LOCATION=/srv/immich/library

# The location where your database files are stored. Network shares are not supported for the database
IMMICH_DB_DATA_LOCATION=/srv/immich/postgres

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#Li    st
TZ=Europe/Berlin

# Connection secret for postgres. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
IMMICH_DB_PASSWORD=change-me

# IMMICH_TELEMETRY_INCLUDE=all

BESZEL_AGENT_KEY=change-me
BESZEL_AGENT_TOKEN=change-me

HOMEPAGE_VAR_JELLYFIN_KEY=change-me
HOMEPAGE_VAR_IMMICH_KEY=change-me
HOMEPAGE_VAR_NPM_USER=change-me@gmx.de
HOMEPAGE_VAR_NPM_PASSWORD=change-me

OPENGYM_RP_ID=change-me.org
OPENGYM_RP_NAME=openGym
OPENGYM_ORIGIN=https://change-me.org
OPENGYM_NGINX_PORT=1234
OPENGYM_PORT=5678

NB_SETUP_KEY=change-me

# The values below this line do not need to be changed
###################################################################################
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
